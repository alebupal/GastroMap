# Base de datos (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_DB=gastromap
POSTGRES_USER=gastromap
POSTGRES_PASSWORD=gastromap_secret_change_me
DB_PORT=5432

# URL de conexión local para Next.js / Drizzle
DATABASE_URL=postgres://gastromap:gastromap_secret_change_me@localhost:5432/gastromap

# Secreto de sesión (mínimo 32 caracteres)
SESSION_SECRET=generar_un_secreto_largo_aleatorio_para_firmar_cookies

# Puerto de la aplicación
PORT=3000
